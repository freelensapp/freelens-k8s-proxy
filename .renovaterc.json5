{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled"
  ],
  "addLabels": [
    "renovate"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  // Renovate's mise manager sees only mise.toml, i.e. just goreleaser; the Go
  // version comes from .go-version through a regex custom manager and regex
  // managers never touch lockfiles. So after every .go-version bump the "go"
  // entries in mise.lock go stale, and the next local `mise install` re-locks
  // only the current platform, silently dropping the other seven. Lock file
  // maintenance runs plain `mise lock`, which relocks every tool on every
  // platform already present in the file. Defaults are disabled and weekly,
  // hence the explicit settings.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "automerge": true
  },
  "constraints": {
    // allow minor updates for go
    "go": ">= 1.23"
  },
  "customManagers": [
    // .go-version file
    {
      "customType": "regex",
      "extractVersionTemplate": "^(?<version>.*)$",
      "managerFilePatterns": [
        "/^\\.go-version$/"
      ],
      "matchStrings": [
        "(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "versioningTemplate": "semver"
    },
    // go.mod file
    {
      "customType": "regex",
      "extractVersionTemplate": "^(?<version>.*)$",
      "managerFilePatterns": [
        "/^go\\.mod$/"
      ],
      "matchStrings": [
        "\\sgo\\s(?<currentValue>.+?)\\s"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "versioningTemplate": "semver"
    },
    // renovate hints after comment
    {
      "customType": "regex",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/",
        "/^\\.trunk/trunk.yaml/"
      ],
      "matchStrings": [
        "(\\s+|.*?@)(?<currentValue>\\S+?)!?\\s*#\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+versioning=(?<versioning>\\S+))?(\\s+registryUrl=(?<registryUrl>\\S+))?\\s*\\n"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
